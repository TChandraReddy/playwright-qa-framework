{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript QA automation framework: Page Object Model, data-driven tests, hybrid UI/API coverage, and CI.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test tests/ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "test-automation", "qa", "page-object-model"],
  "author": "Chandra Reddy Tadi",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
